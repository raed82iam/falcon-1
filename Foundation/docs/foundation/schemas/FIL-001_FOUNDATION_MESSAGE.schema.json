{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:falcon:fil:schema:foundation-message:1.1",
  "title": "Falcon Foundation FIL Message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "kind",
    "type",
    "schema_id",
    "schema_version",
    "producer_id",
    "created_at",
    "purpose",
    "classification",
    "priority_authority",
    "protection_profile",
    "protection_version",
    "integrity_scope",
    "key_ref",
    "replay_policy",
    "integrity",
    "payload"
  ],
  "properties": {
    "message_id": {"type": "string", "minLength": 16, "maxLength": 128},
    "kind": {"enum": ["Command", "Query", "Response", "Event", "Notice"]},
    "type": {"type": "string", "pattern": "^foundation\\.[a-z0-9.-]+\\.v1$"},
    "schema_id": {"const": "urn:falcon:fil:schema:foundation-message:1.1"},
    "schema_version": {"const": "1.1"},
    "producer_id": {"type": "string", "minLength": 3, "maxLength": 256},
    "created_at": {"type": "string", "format": "date-time"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 256},
    "classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "target": {"type": "string", "minLength": 1, "maxLength": 256},
    "topic": {"type": "string", "minLength": 1, "maxLength": 256},
    "authority_context": {"type": "string", "minLength": 1, "maxLength": 256},
    "correlation_id": {"type": "string", "minLength": 16, "maxLength": 128},
    "causation_id": {"type": "string", "minLength": 16, "maxLength": 128},
    "fact_owner": {"type": "string", "minLength": 3, "maxLength": 256},
    "expires_at": {"type": "string", "format": "date-time"},
    "priority_authority": {"type": "string", "minLength": 1, "maxLength": 128},
    "protection_profile": {"enum": ["FIL-P1", "FIL-P2", "FIL-P3", "FIL-P4"]},
    "protection_version": {"const": "1.0"},
    "integrity_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "key_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "replay_policy": {"type": "string", "minLength": 1, "maxLength": 128},
    "recipient_binding": {"type": "string", "minLength": 1, "maxLength": 256},
    "delivery_attempt_id": {"type": "string", "minLength": 16, "maxLength": 128},
    "nonce": {"type": "string", "minLength": 1, "maxLength": 512},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "value"],
      "properties": {
        "profile": {"type": "string", "minLength": 1, "maxLength": 128},
        "value": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "Command"}}, "required": ["kind"]},
      "then": {"required": ["target", "authority_context", "expires_at"]}
    },
    {
      "if": {"properties": {"kind": {"const": "Query"}}, "required": ["kind"]},
      "then": {"required": ["target", "expires_at"]}
    },
    {
      "if": {"properties": {"kind": {"const": "Response"}}, "required": ["kind"]},
      "then": {"required": ["correlation_id"]}
    },
    {
      "if": {"properties": {"kind": {"const": "Event"}}, "required": ["kind"]},
      "then": {"required": ["fact_owner"]}
    }
  ]
}
